# SoulHarbor product app — example environment overrides.
# Copy to product_app/.env (or export in the shell) as needed.
# Values here override product_app/app/memory/config.py defaults.

MEMORY_BACKEND=er

# Candidate caps only — not a guarantee of injection count.
# CE keeps at most N unique-message anchors; post-merge Top-k keeps at most N windows.
# Token budget then decides how many of those windows enter the prompt.
MEMORY_ANCHOR_CE_TOP_K=12
MEMORY_WINDOW_TOP_K=12

# MEMORY_CONTEXT_TOKEN_BUDGET=1600
