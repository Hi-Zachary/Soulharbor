# SoulHarbor product app — example environment overrides.
# Copy to product_app/.env (or export in the shell) as needed.
# Values here override product_app/app/memory/config.py defaults.

MEMORY_BACKEND=er

# Candidate caps only — not a guarantee of injection count.
# Direct: original-query CE Top-K (message_id unique).
# Split: each subquery CE Top-3 ∪ fill from original CE to Top-K (Planner ≤3 subs).
# Token budget then decides how many windows enter the prompt.
MEMORY_ANCHOR_CE_TOP_K=10
MEMORY_ANCHOR_CE_DIRECT_K=10
MEMORY_ANCHOR_CE_PER_SUBQUERY_K=3
MEMORY_WINDOW_TOP_K=10

# Active long-term profile hard caps (code-enforced).
MEMORY_PROFILE_MAX_ACTIVE=20
MEMORY_PROFILE_ITEM_TARGET_CHARS=40
MEMORY_PROFILE_ITEM_MAX_CHARS=64
MEMORY_PROFILE_ITEM_MAX_TOKENS=48
MEMORY_PROFILE_BLOCK_MAX_TOKENS=640
MEMORY_PROFILE_MAX_OPERATIONS=3

# Display timezone for「记录于」and「当前日期」.
MEMORY_TIMEZONE=Asia/Shanghai

# MEMORY_CONTEXT_TOKEN_BUDGET=1600
